---
import Base from "../layouts/Base.astro"; import InnerHero from "../components/site/InnerHero.astro"; import {formatPhone,getSiteModel,heroImgs} from "../lib/site"; const model=await getSiteModel(Astro); const {content}=model; const phone=content["contact.salesPhone"]||"0939612555", tech=content["contact.techPhone"]||"", email=content["contact.email"]||"homeliftvietnam@gmail.com", address=content["contact.address"]||"", zalo=content["contact.zalo"]||`https://zalo.me/${phone}`;
---
<Base model={model} page="contact"><InnerHero image={heroImgs[3]} title={content["contact.title"]||"Liên hệ"} tall/><main class="wrap py-16 lg:py-24"><div class="mx-auto max-w-3xl text-center" data-aos="fade-up"><p class="kicker">Liên hệ</p><h2 class="section-title">{content["contact.title"]}</h2><p class="mt-5 text-muted">{content["contact.intro"]}</p></div><div class="mx-auto mt-10 max-w-3xl rounded-[2rem] bg-franz-soft p-8 shadow-sm" data-aos="fade-up"><p><b>Showroom Hà Nội:</b> {address}</p><p class="mt-3"><b>Kinh doanh:</b> <a class="text-franz font-semibold" href={`tel:${phone}`}>{formatPhone(phone)}</a></p>{tech&&<p class="mt-3"><b>Kỹ thuật:</b> <a class="text-franz font-semibold" href={`tel:${tech}`}>{formatPhone(tech)}</a></p>}<p class="mt-3"><b>Email:</b> <a class="text-franz font-semibold" href={`mailto:${email}`}>{email}</a></p><p class="mt-3"><b>Zalo:</b> <a class="text-franz font-semibold" href={zalo} target="_blank" rel="noopener">Chat qua Zalo</a></p><div class="mt-8 flex flex-wrap gap-4"><a class="btn btn-primary" href={`tel:${phone}`}>Gọi Ngay</a><a class="btn btn-outline" href={`mailto:${email}`}>Nhận Báo Giá</a></div></div></main></Base>
