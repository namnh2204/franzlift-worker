---
import Base from "../layouts/Base.astro";
import Picture from "../components/site/Picture.astro";
import { advImgs, getSiteModel, heroImgs, pageUrl, text, toYoutubeEmbed } from "../lib/site";
const model = await getSiteModel(Astro);
const { content, products, posts } = model;
const siteName = content["branding.siteName"] || "Thang Máy Nhập Khẩu Franz";
const heroes = content.homeHeroSlides?.length ? content.homeHeroSlides : [["Franz Home Lift", "Thang máy nhập khẩu Franz công nghệ Đức, không hố pit, không phòng máy.", heroImgs[0]]];
const stats = content.homeStats?.length ? content.homeStats : [["100%","Nhập khẩu nguyên chiếc"],["60mm","Hố Pit tối thiểu"],["5 sao","Đánh giá chất lượng"],["24/7","Hỗ trợ kỹ thuật"]];
const cases = content.homeCases?.length ? content.homeCases : [];
const reasons = content.homeReasons?.length ? content.homeReasons : [];
const testimonials = content.testimonials?.length ? content.testimonials : [];
---
<Base model={model} page="home">
<section class="fl-hero"><div class="hero-swiper swiper fl-hero-swiper"><div class="swiper-wrapper">{heroes.map((slide: any[], i: number) => <div class="swiper-slide fl-hero-slide"><Picture src={slide[2]} alt={`${slide[0]} – ${siteName}`} eager={i === 0} sizes="100vw" /><div class="fl-hero-copy"><p>{text(content,"home.heroEyebrow",siteName)}</p>{i === 0 ? <h1 class="is-medium">{slide[0]}</h1> : <h2 class="fl-hero-h is-medium">{slide[0]}</h2>}<div class="fl-hero-lead">{slide[1]}</div><div class="fl-hero-actions"><a href={pageUrl.products}>{text(content,"home.heroProductButton","Khám phá sản phẩm")}</a><a href="#msg">{text(content,"home.heroConsultButton","Nhận tư vấn")}</a></div></div></div>)}</div><div class="swiper-pagination"></div></div></section>
<section class="fl-about-strip"><div class="wrap fl-about-grid"><div class="fl-about-text" data-aos="fade-up"><span>{text(content,"home.aboutEyebrow","Về " + siteName)}</span><h2>{text(content,"home.aboutTitle","Giải pháp thang máy nhập khẩu dành cho gia đình Việt")}</h2><p>{text(content,"home.aboutText", text(content, "about.p1"))}</p><a class="more-link fl-about-link" href={pageUrl.about}>{text(content,"home.aboutButton","Tìm hiểu về chúng tôi")} →</a></div><div class="fl-about-media" data-aos="fade-left"><iframe src={toYoutubeEmbed(text(content,"home.aboutVideo"))} title={`Giới thiệu ${siteName}`} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe></div></div></section>
<section class="tp-stats" aria-label={`Năng lực ${siteName}`}><div class="wrap tp-stats-grid">{stats.map((stat: any[]) => <div><strong>{stat[0]}</strong><span>{stat[1]}</span></div>)}</div></section>
<section id="products" class="fl-products"><div class="wrap"><div class="fl-section-title" data-aos="fade-up"><span>{text(content,"home.productEyebrow","Sản phẩm")}</span><h2>{text(content,"home.productTitle","Giải pháp cho mọi không gian sống")}</h2><p>{text(content,"home.productIntro")}</p></div></div><div class="fl-prod-rail" data-aos="fade-up" aria-label="Danh sách sản phẩm, kéo ngang để xem thêm">{products.map((p) => <a class="fl-prod-card" href={`/san-pham/${p.slug}`}><div class="fl-prod-card-img"><Picture src={p.image} alt={p.name} sizes="(max-width:640px) 80vw, 340px" /></div><div class="fl-prod-card-body"><h3>{p.name}</h3><p>{p.summary}</p><span>Xem chi tiết →</span></div></a>)}</div><div class="wrap fl-prod-railfoot"><a class="fl-prod-all" href={pageUrl.products}>Xem tất cả sản phẩm →</a></div></section>
<section class="tp-consult-banner"><div class="wrap tp-consult-inner" data-aos="fade-up"><div><span>{text(content,"home.consultEyebrow","Tư vấn chuyên sâu")}</span><h2>{text(content,"home.consultTitle","Bạn chưa chọn được mẫu thang phù hợp?")}</h2><p>{text(content,"home.consultText")}</p></div><a href="#msg">{text(content,"home.consultButton","Nhận tư vấn")} →</a></div></section>
<section class="fl-vr" id="vr360"><div class="wrap fl-vr-grid"><div data-aos="fade-right"><span>{text(content,"vr.eyebrow","Trải nghiệm 360°")}</span><h2>{text(content,"home.vrTitle","Khám phá thang máy Franz 360 độ")}</h2><p>{text(content,"home.vrText","Khám phá chi tiết không gian và nội thất các dòng thang máy qua công nghệ thực tế ảo 360° VR, trực quan và sống động. Lựa chọn thiết kế cabin phù hợp nhất cho không gian gia đình bạn.")}</p><div class="fl-vr-actions"><a class="fl-vr-main-btn" href={content["vr.url"] || "https://vr.justeasy.cn/view/1845656k57jm8951-1657245612.html"} target="_blank" rel="noopener">{text(content,"vr.button","Trải nghiệm Cabin 360° VR")} ↗</a><a class="fl-vr-sub-link" href={pageUrl.vr}>Xem tất cả mẫu cabin →</a></div></div><div class="fl-vr-media-box" data-aos="fade-left"><a href={content["vr.url"] || "https://vr.justeasy.cn/view/1845656k57jm8951-1657245612.html"} target="_blank" rel="noopener" aria-label="Mở xem 360 độ"><Picture src="/assets-local/vr-select-elevator.jpg" alt="Trải nghiệm 360° thang máy Franz" sizes="(max-width:1023px) 100vw, 50vw" /><span class="fl-vr-tag">360° VR Trực quan</span></a></div></div></section>
<section class="fl-cases"><div class="wrap"><div class="fl-section-title" data-aos="fade-up"><span>{text(content,"home.caseEyebrow","Dự án")}</span><h2>{text(content,"home.caseTitle","Những công trình tiêu biểu")}</h2><p>{text(content,"home.caseIntro")}</p></div><div class="case-swiper swiper fl-case-swiper" data-aos="fade-up"><div class="swiper-wrapper">{cases.map((item: any[], i: number) => { const fallback = [...heroImgs,...advImgs][i % 8]; const images = [item[2] || fallback, ...(Array.isArray(item[3]) ? item[3].filter(Boolean) : [])]; return <article class="swiper-slide fl-case-card"><a class="fl-case-images" href={images[0]} data-lightbox data-title={item[0]} aria-label={`Xem ảnh lớn: ${item[0]}`}>{images.map((src: string, j: number) => <Picture src={src} alt={item[0]} active={j===0} sizes="(max-width:640px) 84vw, 33vw" />)}</a><button type="button" class="fl-case-view-btn" data-lightbox-trigger data-href={images[0]} data-title={item[0]}>🔍 Xem ảnh chi tiết</button><div><h3>{item[0]}</h3>{item[1] && <p>{item[1]}</p>}</div></article> })}</div><div class="swiper-pagination"></div></div><div class="fl-prod-railfoot"><a class="fl-prod-all" href={pageUrl.projects}>Xem tất cả dự án →</a></div></div></section>
{testimonials.length > 0 && (
<section class="fl-testimonials"><div class="wrap"><div class="fl-section-title" data-aos="fade-up"><span>{text(content,"home.testiEyebrow","Khách hàng nói về Franz")}</span><h2>{text(content,"home.testiTitle","Chia sẻ của khách hàng khi sử dụng thang máy Franz")}</h2><p>{text(content,"home.testiIntro","Sự hài lòng và an tâm của mỗi gia đình là minh chứng rõ nhất cho chất lượng và sự tận tâm của chúng tôi.")}</p></div><div class="fl-testimonial-swiper swiper" data-aos="fade-up"><div class="swiper-wrapper">{testimonials.map((t: any) => <div class="swiper-slide fl-testimonial-card"><div class="fl-testi-media">{t.video_url ? <iframe src={toYoutubeEmbed(t.video_url)} title={`Feedback từ ${t.name}`} loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe> : <Picture src={t.image || heroImgs[0]} alt={t.name} sizes="(max-width:640px) 100vw, 33vw" />}</div><div class="fl-testi-meta"><h3 class="fl-testi-name">{t.name}</h3><span class="fl-testi-addr">📍 {t.address}</span></div><div class="fl-testi-content"><p>“{t.content}”</p><div class="fl-testi-stars">★★★★★</div></div></div>)}</div><div class="fl-testi-nav"><button type="button" class="fl-testi-btn-prev" aria-label="Đánh giá trước">←</button><div class="swiper-pagination"></div><button type="button" class="fl-testi-btn-next" aria-label="Đánh giá tiếp theo">→</button></div></div></div></section>
)}
<section class="tp-why"><div class="wrap"><div class="fl-section-title" data-aos="fade-up"><span>{text(content,"home.whyEyebrow","Khác biệt " + siteName)}</span><h2>{text(content,"home.whyTitle", "Vì sao chọn thang máy gia đình Franz?")}</h2></div><div class="tp-why-grid"><div class="tp-why-media" data-aos="fade-right"><Picture src={reasons[0]?.[2] || text(content,"home.whyImage",advImgs[0])} alt={`Kỹ thuật và thang máy ${siteName}`} sizes="(max-width:1023px) 100vw, 50vw" /></div><div class="tp-reasons" data-aos="fade-left">{reasons.map((reason: any[], i: number) => <details open={i===0} data-img={reason[2] || advImgs[i % advImgs.length]}><summary><span>{String(i+1).padStart(2,"0")}</span>{reason[0]}</summary><p>{reason[1]}</p></details>)}</div></div></div></section>
<section class="fl-news"><div class="wrap"><div class="fl-news-head" data-aos="fade-up"><div><span>{text(content,"home.newsEyebrow","Tin tức")}</span><h2>{text(content,"home.newsTitle")}</h2></div><p>{text(content,"home.newsIntro")}</p></div><div class="fl-news-grid">{posts.slice(0,3).map((post,i) => <a class="fl-news-card" href={`/tin-tuc/${post.slug}`} data-aos="fade-up" data-aos-delay={i*80}><Picture src={post.image || heroImgs[i]} alt={post.title} sizes="(max-width:640px) 100vw, 33vw" /><div><time>{post.date}</time><h3>{post.title}</h3><p>{post.excerpt}</p></div></a>)}</div><div class="fl-prod-railfoot"><a class="fl-prod-all" href={pageUrl.blog}>Xem tất cả bài viết →</a></div></div></section>
<section class="fl-message" id="msg"><div class="wrap fl-message-grid"><div data-aos="fade-right"><span>{text(content,"home.messageEyebrow","Nhận tư vấn")}</span><h2>{text(content,"home.messageTitle")}</h2><p>{text(content,"home.messageIntro")}</p></div><form data-aos="fade-left" action={pageUrl.contact} method="get"><label><span>Họ và tên</span><input name="name" type="text" placeholder="Nguyễn Văn A" autocomplete="name" required /></label><label><span>Số điện thoại</span><input name="phone" type="tel" placeholder="09xx xxx xxx" autocomplete="tel" required /></label><label class="tp-form-wide"><span>Khu vực / công trình</span><input name="project" type="text" placeholder="Địa điểm và loại công trình" /></label><label class="tp-form-wide"><span>Nhu cầu tư vấn</span><textarea name="message" placeholder="Chia sẻ nhu cầu của bạn"></textarea></label><button type="submit">{text(content,"home.messageButton","Tư vấn cho tôi")}</button><small>{text(content,"home.messagePrivacy")}</small></form></div></section>
<dialog class="tp-lightbox" id="projectLightbox"><button type="button" aria-label="Đóng ảnh">×</button><img src="" alt="" /><p></p></dialog>
</Base>
