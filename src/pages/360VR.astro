---
import Base from "../layouts/Base.astro"; import Picture from "../components/site/Picture.astro"; import {getSiteModel} from "../lib/site"; const model=await getSiteModel(Astro); const {content}=model; const url=content["vr.url"]||"https://vr.justeasy.cn/view/1845656k57jm8951-1657245612.html";
---
<Base model={model} page="vr"><section class="fl-detail-hero fl-vr-hero"><Picture src="/assets-local/vr-cabins/vr-hero.jpg" alt={content["vr.title"]||"Trải nghiệm 360° VR"} eager sizes="100vw"/><div><p>{content["vr.eyebrow"]||"Trải nghiệm 360°"}</p><h1>{content["vr.title"]||"Trải nghiệm 360° VR"}</h1><a href={url} target="_blank" rel="noopener">{content["vr.button"]||"Mở trải nghiệm 360°"}</a></div></section><main class="fl-detail-page wrap"><div class="fl-section-title"><span>{content["vr.cabinEyebrow"]||"Mẫu cabin"}</span><h2>{content["vr.cabinTitle"]||"Chọn mẫu cabin thang máy"}</h2></div><section class="fl-vr-cabin-grid">{(content.vrCabins||[]).map((c:any[])=><article><Picture src={c[2]} alt={c[0]} sizes="(max-width:1023px) 50vw, 33vw"/><div><h3>{c[0]}</h3><p>{c[1]}</p><a href={c[3]||url} target="_blank" rel="noopener">Xem 360°</a></div></article>)}</section></main></Base>
