---
import Base from "../layouts/Base.astro";
import InnerHero from "../components/site/InnerHero.astro";
import Picture from "../components/site/Picture.astro";
import { getSiteModel, heroImgs, toYoutubeEmbed } from "../lib/site";
const model = await getSiteModel(Astro);
const { content } = model;
const projects = content.projects || [];
---
<Base model={model} page="projects">
	<InnerHero image={heroImgs[3]} title={content["projects.title"] || "Dự Án Tiêu Biểu"} intro={content["projects.intro"] || "Những công trình thực tế khẳng định năng lực thi công và đẳng cấp chất lượng từ Franz Home Lift."} />
	<main class="wrap py-16 lg:py-24">
		<div class="fl-cat-grid">
			{projects.map((p: any[], i: number) => {
				const images = [p[2] || heroImgs[i % 4], ...(Array.isArray(p[3]) ? p[3].filter(Boolean) : [])];
				const videoUrl = p[4] || "";
				return (
					<article class="fl-cat-card" data-aos="fade-up" data-aos-delay={(i % 3) * 80}>
						<div class="fl-cat-card-img" style="position:relative;">
							{videoUrl ? (
								<iframe src={toYoutubeEmbed(videoUrl)} title={p[0]} style="width:100%;height:100%;border:0;" loading="lazy" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" referrerpolicy="strict-origin-when-cross-origin" allowfullscreen></iframe>
							) : (
								<a class="fl-project-link-img" href={images[0]} data-lightbox data-title={p[0]} style="display:block;width:100%;height:100%;" aria-label={`Xem ảnh lớn: ${p[0]}`}>
									<div data-case-rotator style="width:100%;height:100%;">
										{images.map((src: string, j: number) => <Picture src={src} alt={p[0]} active={j === 0} sizes="(max-width:1023px) 50vw, 33vw" />)}
									</div>
									<button type="button" class="fl-case-view-btn" data-lightbox-trigger data-href={images[0]} data-title={p[0]}>🔍 Xem ảnh</button>
								</a>
							)}
						</div>
						<div class="fl-cat-card-body">
							<h2>{p[0]}</h2>
							<p>{p[1]}</p>
						</div>
					</article>
				);
			})}
		</div>
	</main>
	<dialog class="tp-lightbox" id="projectLightbox"><button type="button" aria-label="Đóng ảnh">×</button><img src="" alt="" /><p></p></dialog>
</Base>
