    <div class="mt-8 flex flex-wrap justify-center gap-4"><a class="btn btn-primary" href="/">Về trang chủ</a><a class="btn btn-ghost" href="<%= pageUrl.products %>">Xem sản phẩm</a></div>
  </div>
</section>

<% } else if (page === 'vr') { %>
<section class="fl-detail-hero fl-vr-hero">
