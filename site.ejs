    <div class="mt-10 flex flex-wrap gap-4"><a class="btn btn-primary" href="tel:<%= salesPhone %>">Gọi <%= fmtPhone(salesPhone) %></a><a class="btn btn-outline" href="<%= pageUrl.blog %>">← Tin tức khác</a></div>
  </article>
</main>

<% } else if (page === 'notfound') { %>
<section class="relative min-h-[60vh] overflow-hidden bg-ink pt-20 flex items-center">
