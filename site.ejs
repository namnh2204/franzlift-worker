    <% if (techPhone) { %><p class="mt-3"><b>Kỹ thuật:</b> <a class="text-franz font-semibold" href="tel:<%= techPhone %>"><%= fmtPhone(techPhone) %></a></p><% } %>
    <p class="mt-3"><b>Email:</b> <a class="text-franz font-semibold" href="mailto:<%= email %>"><%= email %></a></p>
    <p class="mt-3"><b>Zalo:</b> <a class="text-franz font-semibold" href="<%= zalo %>" target="_blank" rel="noopener">Chat qua Zalo</a></p>
    <div class="mt-8 flex flex-wrap gap-4"><a class="btn btn-primary" href="tel:<%= salesPhone %>">Gọi Ngay</a><a class="btn btn-outline" href="mailto:<%= email %>">Nhận Báo Giá</a></div>
  </div>
  <% } %>
