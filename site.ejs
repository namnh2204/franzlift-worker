    <% }) %>
  </div>
  <div class="mt-12 flex flex-wrap gap-4"><a class="btn btn-primary" href="tel:<%= hotline %>">Gọi <%= fmtPhone(salesPhone) %></a><a class="btn btn-outline" href="<%= zalo %>" target="_blank" rel="noopener">Chat Zalo</a></div>
</main>

<% } else if (page === 'projects') { %>
