  <a href="<%= zalo %>" target="_blank" rel="noopener" title="Chat Zalo" aria-label="Chat Zalo"><svg viewBox="0 0 48 48" aria-hidden="true"><rect width="48" height="48" rx="12" fill="#0068FF"/><text x="24" y="31" font-family="Arial, Helvetica, sans-serif" font-size="17" font-weight="700" fill="#fff" text-anchor="middle">Zalo</text></svg></a>
</div>
