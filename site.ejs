    </div>
  </div>
</section>
<main class="wrap py-16 lg:py-24">
  <div class="fl-news-grid">
    <% postItems.forEach((n,i)=>{ %>
    <a class="fl-news-link" href="<%= postUrl(n) %>" data-aos="fade-up" data-aos-delay="<%= (i%3)*80 %>"><%- img(n.image || heroImgs[i%4], n.title, { sizes: '(max-width:640px) 84vw, 33vw' }) %><div><time><%= n.date || '' %></time><h2 class="fl-news-h"><%= n.title %></h2><p><%= n.excerpt %></p></div></a>
