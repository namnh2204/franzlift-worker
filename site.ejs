      <% if (techPhone) { %><p><b>Kỹ thuật:</b> <a href="tel:<%= techPhone %>"><%= fmtPhone(techPhone) %></a></p><% } %>
      <p><b>Email:</b> <a href="mailto:<%= email %>"><%= email %></a></p>
      <div class="fl-footer-socials">
        <a class="fl-footer-zalo" href="<%= zalo %>" target="_blank" rel="noopener">Chat Zalo OA</a>
