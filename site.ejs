      <p class="mt-4 max-w-2xl text-white/80"><%= content['products.intro'] || '' %></p>
    </div>
  </div>
</section>
<main class="wrap py-16 lg:py-24">
  <div class="fl-cat-grid">
    <% productItems.forEach((p) => { %>
    <a class="fl-cat-card" href="<%= productUrl(p) %>">
      <div class="fl-cat-card-img"><%- img(p.image, p.name, { sizes: '(max-width:1023px) 50vw, 33vw' }) %></div>
      <div class="fl-cat-card-body"><h2><%= p.name %></h2><p><%= p.summary %></p><span>Xem chi tiết →</span></div>
    </a>
    <% }) %>
  </div>
</main>

<% } else if (page === 'services') { %>
<section class="relative min-h-[420px] overflow-hidden bg-ink pt-20">
