{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "franzlift-emdash",
	"main": "./src/worker.ts",
	"compatibility_date": "2026-02-24",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": true,
	"routes": [
		{ "pattern": "franzlift.vn", "custom_domain": true },
		{ "pattern": "www.franzlift.vn", "custom_domain": true },
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "franzlift-emdash",
			"database_id": "3096b02d-4413-4982-9926-969b959f1ef0"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "franzlift-emdash-media"
		}
	],
	"kv_namespaces": [
		{
			"binding": "SESSION",
			"id": "01fc2789cbb14300a212ddc1b906dd80"
		}
	],
	"triggers": {
		"crons": ["* * * * *", "*/2 * * * *"]
	}
}
