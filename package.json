{
  "name": "franzlift",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:css": "tailwindcss -i ./src/input.css -o ./public/app.css --minify",
    "watch:css": "tailwindcss -i ./src/input.css -o ./public/app.css --watch",
    "copy:vendor": "node scripts/copy-vendor.js",
    "optimize:images": "node scripts/optimize-images.js",
    "build": "npm run optimize:images && npm run build:css && npm run copy:vendor",
    "start": "node server.js",
    "dev": "node server.js",
    "dev:worker": "wrangler dev",
    "deploy:worker": "wrangler deploy",
    "migrate:worker": "node scripts/migrate-cloudflare.js"
  },
  "dependencies": {
    "ejs": "^3.1.10",
    "express": "^4.19.2",
    "jose": "^6.2.9",
    "multer": "^1.4.5-lts.1",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.35.3",
    "tinymce": "^8.8.2"
  },
  "devDependencies": {
    "aos": "^2.3.4",
    "autoprefixer": "^10.5.4",
    "postcss": "^8.5.26",
    "swiper": "^14.1.0",
    "tailwindcss": "^3.4.14",
    "wrangler": "^4.124.0"
  }
}
