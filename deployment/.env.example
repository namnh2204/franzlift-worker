# Copy to deployment/.env and replace placeholders.
# Use a scoped Cloudflare API token, not the Global API Key.
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_API_TOKEN=your_scoped_cloudflare_api_token

# S3-compatible R2 credentials are only needed for external S3 tools.
AWS_ACCESS_KEY_ID=your_r2_access_key_id
AWS_SECRET_ACCESS_KEY=your_r2_secret_access_key
CLOUDFLARE_R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
CLOUDFLARE_R2_BUCKET=franzlift-uploads
